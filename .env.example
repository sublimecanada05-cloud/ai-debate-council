# Backend Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://mongodb:27017/ai-debate-council
REDIS_URL=redis://redis:6379

# AI Provider APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_KEY=AIzaSy...
XAI_API_KEY=xai-...

# News & Market Data APIs
NEWSAPI_KEY=your_newsapi_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_key
COINGECKO_API_KEY=your_coingecko_key

# Notification Services
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SENDGRID_API_KEY=SG...
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_URL=https://yoursite.com/webhooks

# JWT & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# AI Model Versions
CHATGPT_MODEL=gpt-4o
CLAUDE_MODEL=claude-3-opus-20250219
GEMINI_MODEL=gemini-2.0-flash
GROK_MODEL=grok-3

# Debate Configuration
DEBATE_ROUND_TIMEOUT=120000
DEBATE_MAX_ROUNDS=5
DEBATE_CONSENSUS_THRESHOLD=0.75
DEBATE_AUTO_CONCLUDE=true
DEBATE_AUTO_CONCLUDE_TIMEOUT=3600000

# Frontend
REACT_APP_API_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000

# Logging
LOG_LEVEL=debug
SENTRY_DSN=https://your_sentry_dsn

# Feature Flags
ENABLE_ASYNC_DEBATES=true
ENABLE_LIVE_UPDATES=true
ENABLE_NOTIFICATIONS=true
ENABLE_WEBHOOK_RETRIES=true
